{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:t(firsttimers|workers|birthdays|quiz|youth|records|graphics)",
      "destination": "/:t/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/sermons",
      "destination": "https://rlw-church.sites.tab.bot/api/sermons"
    },
    {
      "source": "/:t(firsttimers|workers|birthdays|quiz|youth|records|graphics)/",
      "destination": "https://rlw-church.sites.tab.bot/:t/"
    },
    {
      "source": "/:t(firsttimers|workers|birthdays|quiz|youth|records|graphics)",
      "destination": "https://rlw-church.sites.tab.bot/:t/"
    },
    {
      "source": "/:t(firsttimers|workers|birthdays|quiz|youth|records|graphics)/:path(.*)",
      "destination": "https://rlw-church.sites.tab.bot/:t/:path"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
